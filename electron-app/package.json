{
  "name": "mjscxt-desktop",
  "version": "1.0.0",
  "description": "漫剧工坊桌面版：Electron 壳 + 本地 Flask 后端（serve.py）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:backend": "node pack_backend.js",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mjscxt.desktop",
    "productName": "漫剧工坊",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "_backend/python",
        "to": "python"
      },
      {
        "from": "_backend/app",
        "to": "app"
      },
      {
        "from": "_backend/workflows",
        "to": "workflows"
      },
      {
        "from": "_backend/locales",
        "to": "locales"
      },
      {
        "from": "_backend/main.py",
        "to": "main.py",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"],
          "artifactName": "漫剧工坊-Setup-${version}.${ext}"
        },
        {
          "target": "portable",
          "arch": ["x64"],
          "artifactName": "漫剧工坊-Portable-${version}.${ext}"
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
